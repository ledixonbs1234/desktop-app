<Window x:Class="desktop_app.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:desktop_app"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:md="http://schemas.lepo.co/wpfui/2022/xaml/markdown"
        mc:Ignorable="d"
        Title="AI Desktop Assistant" Height="800" Width="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        xml:lang="vi-VN"
        Language="vi-VN"> <!-- Chỉ thị WPF kết xuất bộ dấu tiếng Việt gốc cho Segoe UI -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 🛡️ GHI ĐÈ PHÔNG CHỮ TIẾNG VIỆT CAO CẤP TOÀN CỤC -->
        <!-- Sử dụng tổ hợp phông thiết kế hiện đại của Windows 11 -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Calibri, sans-serif" />
        </Style>
        <Style TargetType="Paragraph">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Calibri, sans-serif" />
        </Style>
        <Style TargetType="Run">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Calibri, sans-serif" />
        </Style>
        <Style TargetType="Span">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Calibri, sans-serif" />
        </Style>
    </Window.Resources>
    
    <Border CornerRadius="8" Background="#202020" BorderBrush="#303030" BorderThickness="1">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Row 0: Title bar -->
                <RowDefinition Height="Auto" /> <!-- Row 1: Image Preview -->
                <RowDefinition Height="Auto" /> <!-- Row 2: Prompt Input & Quick Buttons -->
                <RowDefinition Height="*" />    <!-- Row 3: AI Response Area -->
                <RowDefinition Height="Auto" /> <!-- Row 4: Action Buttons -->
            </Grid.RowDefinitions>

            <!-- Header / Drag Area -->
            <Grid Grid.Row="0" Height="32" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="AI Desktop Assistant" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <Button Content="✕" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center" 
                        Width="32" Height="32"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        Cursor="Hand"
                        Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FF4040"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Image Preview Area -->
            <ui:Card Grid.Row="1" Margin="0,8,0,8" Padding="0" Height="150" Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
                <Image x:Name="PreviewImage" Stretch="Uniform" Source="{Binding CapturedImage}" />
            </ui:Card>

            <!-- Prompt Input & Quick Buttons Panel -->
            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                <ui:TextBox x:Name="PromptTextBox" 
                            PlaceholderText="Hỏi AI về bức ảnh này..." 
                            AcceptsReturn="True" 
                            TextWrapping="Wrap" 
                            MaxHeight="100" 
                            Margin="0,0,0,8" 
                            Text="{Binding UserPrompt, UpdateSourceTrigger=PropertyChanged}" 
                            PreviewKeyDown="PromptTextBox_PreviewKeyDown" />
                
                <!-- Hàng nút gõ nhanh tiện ích thiết kế phẳng tinh tế -->
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <ui:Button Content="📋 Tóm tắt ảnh" 
                               Margin="0,0,6,0" 
                               Padding="8,4" 
                               FontSize="11.5" 
                               Cursor="Hand"
                               Click="QuickButton_Click" 
                               Tag="Tóm tắt thông tin chi tiết về hình ảnh này." />
                               
                    <ui:Button Content="💻 Giải thích Code" 
                               Margin="0,0,6,0" 
                               Padding="8,4" 
                               FontSize="11.5" 
                               Cursor="Hand"
                               Click="QuickButton_Click" 
                               Tag="Giải thích chức năng và logic của đoạn code trong hình này." />
                               
                    <ui:Button Content="🔍 Tìm lỗi &amp; Giải pháp" 
                               Margin="0,0,0,0" 
                               Padding="8,4" 
                               FontSize="11.5" 
                               Cursor="Hand"
                               Click="QuickButton_Click" 
                               Tag="Phân tích và tìm lỗi (nếu có) trong hình ảnh này kèm giải pháp khắc phục." />
                </WrapPanel>
            </StackPanel>

            <!-- AI Response Area (Markdown Rendered with Scroll) -->
            <ui:Card Grid.Row="3" Margin="0,0,0,8" Padding="12">
                <ScrollViewer x:Name="ResponseScrollViewer" 
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="ResponseScrollViewer_PreviewMouseWheel">
                    <md:MarkdownViewer Markdown="{Binding AiResponse}" SizeChanged="MarkdownViewer_SizeChanged" />
                </ScrollViewer>
            </ui:Card>

            <!-- Action Buttons -->
           <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
    <ui:Button Content="Gửi" Appearance="Primary" Command="{Binding SendToAiCommand}" />
</StackPanel>
        </Grid>
    </Border>
</Window>
<Window x:Class="desktop_app.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:desktop_app"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="AI Desktop Assistant" Height="650" Width="450"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">
    
    <Border CornerRadius="8" Background="#202020" BorderBrush="#303030" BorderThickness="1">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header / Drag Area -->
            <Grid Grid.Row="0" Height="32" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="AI Desktop Assistant" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <Button Content="✕" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center" 
                        Width="32" Height="32"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        Cursor="Hand"
                        Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FF4040"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Image Preview Area -->
            <ui:Card Grid.Row="1" Margin="0,8,0,8" Padding="0" MinHeight="150">
                <Image x:Name="PreviewImage" Stretch="Uniform" Source="{Binding CapturedImage}" />
            </ui:Card>

            <!-- Prompt Input -->
            <ui:TextBox Grid.Row="2" PlaceholderText="Hỏi AI về bức ảnh này..." AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="100" Margin="0,0,0,8" Text="{Binding UserPrompt, UpdateSourceTrigger=PropertyChanged}" />

            <!-- AI Response Area -->
            <ui:Card Grid.Row="3" Margin="0,0,0,8" Padding="12" MinHeight="60">
                <TextBlock Text="{Binding AiResponse}" TextWrapping="Wrap" Foreground="White" />
            </ui:Card>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Gửi" Appearance="Primary" Command="{Binding SendToAiCommand}" IsEnabled="{Binding HasImage}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
<Window x:Class="desktop_app.CropOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crop Overlay" 
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent" 
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowState="Maximized">
    
    <Grid>
        <!-- Ảnh nền đã chụp sẵn -->
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" />
        
        <!-- Lớp phủ tối nhẹ để làm nổi bật vùng chọn -->
        <Rectangle Fill="#40000000" />
        
        <!-- Canvas nhận sự kiện chuột -->
        <Canvas x:Name="OverlayCanvas" 
                Background="Transparent"
                MouseLeftButtonDown="OverlayCanvas_MouseLeftButtonDown" 
                MouseMove="OverlayCanvas_MouseMove" 
                MouseLeftButtonUp="OverlayCanvas_MouseLeftButtonUp">
            
            <!-- Khung vùng chọn trong suốt -->
            <Rectangle x:Name="SelectionRect" 
                       Stroke="#FF409EFF" 
                       StrokeThickness="2" 
                       Fill="Transparent" 
                       Visibility="Collapsed" />
            
            <TextBlock Text="Kéo chuột để chọn vùng... Nhấn ESC để hủy." 
                       Foreground="White" 
                       FontSize="16" 
                       Canvas.Top="20" 
                       Canvas.Left="20" 
                       FontWeight="SemiBold"/>
        </Canvas>
    </Grid>
</Window>